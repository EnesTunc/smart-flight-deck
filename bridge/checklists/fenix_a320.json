          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "beacon_off",
          "challenge": "Beacon",
          "expected_response": "Off",
          "verification": {
            "type": "lvar",
            "variable": "S_OH_EXT_LT_BEACON",
            "condition": "equals",
            "value": 0
          },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "apu_bleed_off",
          "challenge": "APU bleed",
          "expected_response": "Off",
          "verification": {
            "type": "lvar",
            "variable": "S_OH_PNEUMATIC_APU_BLEED",
            "condition": "equals",
            "value": 0
          },
          "action": { "type": "none" },
          "critical": false
        }
