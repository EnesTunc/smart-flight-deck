          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "runway_turnoff",
          "challenge": "Runway turnoff lights",
          "expected_response": "On",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        }
      ]
