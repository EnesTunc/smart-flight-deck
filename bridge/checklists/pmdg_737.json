      "name": "Approach",
      "phase": "APPROACH",
      "items": [
        {
          "id": "altimeters_approach",
          "challenge": "Altimeters",
          "expected_response": "Set",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "seat_belts",
          "challenge": "Seat belt sign",
          "expected_response": "On",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
