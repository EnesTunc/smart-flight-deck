{
  "aircraft": "PMDG 737",
  "version": "1.0",
  "author": "Smart Flight Deck",
  "notes": "PMDG 737-700/800/900 series. Uses numeric LVAR naming convention.",
  "checklists": {
    "cockpit_preparation": {
      "name": "Cockpit Preparation",
      "phase": "PREFLIGHT",
      "items": [
        {
          "id": "battery",
          "challenge": "Battery",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "ELECTRICAL_Battery_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "standby_power",
          "challenge": "Standby power",
          "expected_response": "Auto",
          "verification": {
            "type": "lvar",
            "variable": "ELECTRICAL_StandbyPower_Selector",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "ground_power",
          "challenge": "Ground power",
          "expected_response": "Connected",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "irs_mode",
          "challenge": "IRS mode selectors",
          "expected_response": "Nav",
          "verification": {
            "type": "lvar",
            "variable": "IRS_L_Mode_Selector",
            "condition": "equals",
            "value": 2
          },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "nav_lights",
          "challenge": "Navigation lights",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "LIGHTING_Navigation_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "emergency_lights",
          "challenge": "Emergency exit lights",
          "expected_response": "Armed",
          "verification": {
            "type": "lvar",
            "variable": "LIGHTING_EmergencyExit_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": false
        }
      ]
    },
    "before_start": {
      "name": "Before Start",
      "phase": "PREFLIGHT",
      "items": [
        {
          "id": "parking_brake",
          "challenge": "Parking brake",
          "expected_response": "Set",
          "verification": {
            "type": "simvar",
            "variable": "BRAKE PARKING INDICATOR",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "fuel_quantity",
          "challenge": "Fuel quantity",
          "expected_response": "Checked",
          "verification": {
            "type": "simvar",
            "variable": "FUEL TOTAL QUANTITY",
            "condition": "greater_than",
            "value": 100
          },
          "action": { "type": "none" },
          "critical": true,
          "warning_if_fail": "Low fuel quantity!"
        },
        {
          "id": "fuel_pumps",
          "challenge": "Fuel pumps",
          "expected_response": "On",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "hydraulic_pumps",
          "challenge": "Hydraulic pumps",
          "expected_response": "On",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "beacon",
          "challenge": "Beacon",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "LIGHTING_Beacon_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "doors",
          "challenge": "Doors",
          "expected_response": "Closed",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "mcp_flt_alt",
          "challenge": "MCP flight altitude",
          "expected_response": "Set",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        }
      ]
    },
    "after_start": {
      "name": "After Start",
      "phase": "ENGINE_START",
      "items": [
        {
          "id": "generators",
          "challenge": "Generators",
          "expected_response": "On",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "probe_heat",
          "challenge": "Probe heat",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "ANTIICE_ProbeHeat_A_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "anti_ice",
          "challenge": "Anti-ice",
          "expected_response": "As required",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "apu",
          "challenge": "APU",
          "expected_response": "Off",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "recall",
          "challenge": "Recall",
          "expected_response": "Checked",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "flight_controls",
          "challenge": "Flight controls",
          "expected_response": "Checked",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "ground_equipment",
          "challenge": "Ground equipment",
          "expected_response": "Clear",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        }
      ]
    },
    "before_taxi": {
      "name": "Before Taxi",
      "phase": "TAXI",
      "items": [
        {
          "id": "flaps",
          "challenge": "Flaps",
          "expected_response": "Set for takeoff",
          "verification": {
            "type": "simvar",
            "variable": "FLAPS HANDLE INDEX",
            "condition": "in_range",
            "min": 1,
            "max": 3
          },
          "action": { "type": "none" },
          "critical": true,
          "warning_if_fail": "Flaps not set for takeoff!"
        },
        {
          "id": "flight_directors",
          "challenge": "Flight directors",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "MCP_FD_Capt_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "taxi_light",
          "challenge": "Taxi lights",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "LIGHTING_Taxi_Switch",
            "condition": "equals",
            "value": 1
