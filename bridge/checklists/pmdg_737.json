          "challenge": "Landing gear",
          "expected_response": "Up and off",
          "verification": {
            "type": "simvar",
            "variable": "GEAR HANDLE POSITION",
            "condition": "equals",
            "value": 0
          },
          "action": { "type": "none" },
          "critical": true,
          "warning_if_fail": "Gear not retracted!"
        },
        {
          "id": "flaps_up",
          "challenge": "Flaps",
          "expected_response": "Up, no lights",
          "verification": {
            "type": "simvar",
            "variable": "FLAPS HANDLE INDEX",
            "condition": "equals",
            "value": 0
          },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "altimeters",
          "challenge": "Altimeters",
          "expected_response": "Set",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "autopilot",
          "challenge": "Autopilot",
          "expected_response": "Engaged",
          "verification": {
            "type": "lvar",
            "variable": "MCP_AP_A_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": false
        }
      ]
