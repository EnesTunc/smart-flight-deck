      "items": [
        {
          "id": "takeoff_briefing",
          "challenge": "Takeoff briefing",
          "expected_response": "Completed",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "flaps_to",
          "challenge": "Flaps",
          "expected_response": "Takeoff position, green light",
          "verification": {
            "type": "simvar",
            "variable": "FLAPS HANDLE INDEX",
            "condition": "in_range",
            "min": 1,
            "max": 2
          },
          "action": { "type": "none" },
          "critical": true,
          "warning_if_fail": "Flaps not in takeoff configuration!"
        },
        {
          "id": "stabilizer_trim",
          "challenge": "Stabilizer trim",
          "expected_response": "Set, green band",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "speedbrake",
          "challenge": "Speed brake",
          "expected_response": "Armed",
          "verification": {
            "type": "lvar",
            "variable": "SPEEDBRAKE_Lever",
            "condition": "equals",
            "value": 0
          },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "transponder",
          "challenge": "Transponder",
          "expected_response": "TA/RA",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "strobe_lights",
          "challenge": "Strobe lights",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "LIGHTING_Strobe_Switch",
            "condition": "equals",
            "value": 1
          },
          "action": { "type": "none" },
          "critical": false
        },
        {
          "id": "landing_lights",
          "challenge": "Landing lights",
          "expected_response": "On",
          "verification": {
            "type": "lvar",
            "variable": "LIGHTING_LandingLight_L_Switch",
            "condition": "equals",
            "value": 2
          },
          "action": { "type": "none" },
          "critical": false
        }
      ]
    },
    "after_takeoff": {
      "name": "After Takeoff",
      "phase": "CLIMB",
      "items": [
        {
