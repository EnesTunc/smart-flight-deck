          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "approach_briefing",
          "challenge": "Approach briefing",
          "expected_response": "Completed",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": true
        },
        {
          "id": "landing_lights_descent",
          "challenge": "Landing lights",
          "expected_response": "On below 10000",
          "verification": { "type": "manual" },
          "action": { "type": "none" },
          "critical": false
        }
